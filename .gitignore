/target/
/pkg/
# wasm-pack --target web output consumed by the Node and Chromium conformance
# suites; rebuilt by `make pkg-web`.
/pkg-web/
*.dylib
*.so
*.dll

# Browser conformance suite
/tests/wasm/node_modules/
/tests/wasm/playwright-report/
/tests/wasm/test-results/
tmp/worktrees
temp/worktrees

# --- environment / secrets (sops + age) -------------------------------------
# Only env/enc/*.env.enc is tracked. Every plaintext form stays out of git;
# `just env-check` enforces it. See env/README.md.
.env
.env.*
*.env
**/*.env
env/dec/
!.env.example

# age private keys — never commit these.
*.agekey
*.age-key
keys.txt
sops-private*.txt

# Sanctioned scratch locations - AGENTS.md requires both, trailing-slash form
tmp/
temp/

# machine-local symlink to ORESoftware/my-ai AGENTS.md; never committed
.ores/

# ORESoftware SOPS dotenv ignore contract (ORESoftware/.github docs/sops-environment-standard.md)
*.env
*/*.env
*/**/*.env
.env.*
*.env.*
!.env.example

/env/dec/

/env/enc/*
!/env/enc/dev.env.enc
!/env/enc/prod.env.enc

# build output (DEN-3945 conformance): never tracked
target/
