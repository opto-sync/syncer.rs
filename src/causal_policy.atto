// AttoLang pure two-replica causal-order reference. Not a compiled adapter.
define module causal_policy as
  pub fnc clock_before(int a0, int a1, int b0, int b1): bool {
    return a0 <= b0 && a1 <= b1 && (a0 < b0 || a1 < b1);
  }

  pub fnc clock_equal(int a0, int a1, int b0, int b1): bool {
    return a0 == b0 && a1 == b1;
  }

  pub fnc clock_concurrent(int a0, int a1, int b0, int b1): bool {
    return !clock_equal(a0,a1,b0,b1) &&
      !clock_before(a0,a1,b0,b1) && !clock_before(b0,b1,a0,a1);
  }

  pub fnc self_check(): bool {
    return clock_before(0,1,1,1) && !clock_before(1,1,0,1) &&
      clock_equal(1,2,1,2) && clock_concurrent(0,2,2,0) &&
      !clock_concurrent(1,1,1,1);
  }
end
